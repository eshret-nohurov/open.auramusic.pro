# Copy to .env next to the binary (chmod 600). The environment overrides it.

# prod: real backend, BACKEND_BASE_URL and SITE_TOKEN are required.
# mock: local backend stub (bm-open mock on 127.0.0.1:3399).
MODE=prod

# Only localhost: nginx proxies the domain here. 3300 is taken by bm-web.
LISTEN_ADDR=127.0.0.1:3310

# Every absolute link (og:url, og:image, QR, app-argument) is built from it,
# never from the Host header.
PUBLIC_ORIGIN=https://open.auramusic.pro

# Where / redirects (with /tm or /ru).
MAIN_SITE_URL=https://auramusic.pro

# Backend API root, without /api/v1. Different for dev and prod.
BACKEND_BASE_URL=

# Site token for /api/v1/internal/deeplink. Secret: never commit, log or paste it.
SITE_TOKEN=

# Hosts the site may download covers from, comma-separated.
IMAGE_HOSTS=cache.ma.st.com.tm

# Cache: found, not found, pause after a backend failure, how long a stale
# answer may be served while the backend is down.
PREVIEW_TTL=1h
NOT_FOUND_TTL=10m
FAIL_TTL=15s
STALE_MAX=24h

# Chat apps wait 3-5 s for a preview.
BACKEND_TIMEOUT=2500ms
BACKEND_MAX_INFLIGHT=16

# Memory for rendered images.
IMAGE_CACHE_MB=128

# stats.jsonl lives here.
DATA_DIR=./data

# Take the client IP from X-Real-IP, only for requests from 127.0.0.1 (nginx).
TRUST_PROXY=true

LOG_LEVEL=info
